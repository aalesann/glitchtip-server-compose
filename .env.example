# Desarrollo local — copiar a .env
# SECRET_KEY, GLITCHTIP_DOMAIN, EMAIL_URL y DEFAULT_FROM_EMAIL ya tienen
# defaults de desarrollo en compose.yml; solo hace falta setear esto:
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=glitchtip
POSTGRES_DB=glitchtip

# Opcional: descomentar para pisar los defaults de dev
# SECRET_KEY=
# GLITCHTIP_DOMAIN=http://localhost:8000
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=dev@localhost
