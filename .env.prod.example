# Producción — copiar a .env.prod y completar. NO commitear el .env.prod.

# PostgreSQL
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=
POSTGRES_DB=glitchtip

# GlitchTip
# Generar con: openssl rand -hex 32
# Cuidado: una variable SECRET_KEY exportada en el shell (ej. en ~/.bashrc)
# tiene PRECEDENCIA sobre este archivo y pisa el valor silenciosamente.
# Verificar siempre con: docker exec glitchtip-web printenv SECRET_KEY
SECRET_KEY=
GLITCHTIP_DOMAIN=https://glitchtip.tu-dominio.com

# Hosts aceptados, separados por coma. Si se deja vacío queda en "*", que
# Django advierte en cada arranque. Incluir 127.0.0.1 y localhost si hay
# procesos nativos del host publicando eventos contra 127.0.0.1:8000.
ALLOWED_HOSTS=glitchtip.tu-dominio.com,127.0.0.1,localhost

# Email. El esquema DEBE ser smtp+tls:// en el puerto 587 — con smtp:// a secas
# Django no negocia STARTTLS y proveedores como AWS SES rechazan el login con
# "530 Must issue a STARTTLS command first". Usar smtp+ssl:// para el 465.
EMAIL_URL=smtp+tls://usuario:password@smtp.host:587
DEFAULT_FROM_EMAIL=glitchtip@tu-dominio.com

# Acceso. Con la instancia expuesta a internet conviene cerrar el registro
# público: solo las cuentas ya existentes pueden entrar, y a los usuarios
# nuevos se los suma por invitación.
ENABLE_USER_REGISTRATION=False
# Permite que cada usuario cree su propia organización (útil para que cada dev
# aísle los errores de su entorno local). La primera organización del servidor
# siempre se puede crear, aunque esto esté en False.
ENABLE_ORGANIZATION_CREATION=True

# Opcional: solo si no tenés un subdominio propio y GlitchTip va a vivir bajo
# un path del dominio central (ej. https://tu-dominio.com/glitchtip/).
# GLITCHTIP_DOMAIN arriba debe quedar SOLO con protocolo+host, sin el path.
# BASE_PATH=/glitchtip
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
